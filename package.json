{
  "name": "sutawane-classes-management-software",
  "version": "1.0.0",
  "description": "Sutawane Classes Management Software - Professional Coaching Institute & Student Fee Accounting System developed by Ultoxy Technologies",
  "author": "Ultoxy Technologies <support@ultoxy.com>",
  "copyright": "Copyright © 2026 Ultoxy Technologies. All rights reserved.",
  "private": true,
  "main": "dist/electron/main.js",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:electron": "concurrently -k -n \"BACKEND,FRONTEND,ELECTRON\" -c \"blue,green,magenta\" \"npm run dev -w backend\" \"npm run dev -w frontend\" \"wait-on tcp:5000 tcp:5173 && npm run electron:start\"",
    "electron:build-ts": "tsc -p electron/tsconfig.json",
    "electron:start": "npm run electron:build-ts && cross-env NODE_ENV=development electron .",
    "build:shared": "npm run build -w shared",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:prod": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend && npm run electron:build-ts",
    "start": "node backend/dist/index.js",
    "test": "vitest run --fileParallelism=false --dir backend/tests",
    "test:db": "npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "db:generate": "npm run prisma:generate -w backend",
    "db:push": "npm run prisma:push -w backend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:studio": "npm run prisma:studio -w backend",
    "package:win": "npm run build && electron-builder --win",
    "package:sign": "npm run package:win && powershell -ExecutionPolicy Bypass -File build/create-cert-and-sign.ps1"
  },
  "build": {
    "appId": "com.ultoxy.sutawaneclasses",
    "productName": "Sutawane Classes Management Software",
    "copyright": "Copyright © 2026 Ultoxy Technologies. All rights reserved.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/electron/**/*",
      "backend/dist/**/*",
      "frontend/dist/**/*",
      "shared/dist/**/*",
      "backend/prisma/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,test,tests,example,examples}",
      "!**/node_modules/*/__tests__/**"
    ],
    "extraResources": [
      {
        "from": "backend/prisma/template.db",
        "to": "backend/prisma/template.db"
      },
      {
        "from": "backend/prisma/logo-master.png",
        "to": "backend/prisma/logo-master.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@prisma/**",
      "**/node_modules/.prisma/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Ultoxy Technologies",
      "publisherName": [
        "Ultoxy Technologies"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Sutawane Classes",
      "uninstallDisplayName": "Sutawane Classes Management Software - Ultoxy Technologies",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2"
  }
}
